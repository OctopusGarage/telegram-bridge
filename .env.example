BOT_TOKEN=replace-me
# Default target tmux session (optional; defaults to telegram_tmux_session).
# Auto-created if it doesn't exist yet.
TMUX_SESSION=telegram_tmux_session
TMUX_WINDOW=0
TMUX_PANE=0
POLL_INTERVAL_MS=1200
MAX_MESSAGE_LENGTH=3500
IDLE_POLL_TICKS=3
MAX_POLL_TICKS=20
HTTPS_PROXY=http://127.0.0.1:7890
# Comma-separated Telegram user IDs with access.
# Fail closed: if empty (and ALLOW_ALL_USERS is not set) ALL users are denied.
ALLOWED_USER_IDS=
# Set to true ONLY to intentionally disable the allowlist (anyone who reaches the bot
# can control your tmux pane). Leave unset/false in normal use.
ALLOW_ALL_USERS=false
# Optional override for persistent state files (lock file / queue state / recent dirs).
# Leave empty to use ~/.telegram-bridge.
TGB_STATE_DIR=
# Max queued commands to keep per-session (in-memory queue)
MAX_QUEUE_SIZE=30
# Max concurrent session queues processed at once
MAX_CONCURRENT_SESSIONS=3
# Max command length sent to tmux (default 5000)
MAX_COMMAND_LENGTH=5000
# Rate limit per user in ms (default 2000)
RATE_LIMIT_MS=2000
# Rate limit per session in ms (default 1200)
SESSION_RATE_LIMIT_MS=1200
# Rate limit across all queued actions in ms (default 500)
GLOBAL_RATE_LIMIT_MS=500
# Commands allowed via /run: comma-separated regex patterns, each auto-anchored
# and matched case-insensitively against the WHOLE command. Empty = deny all (fail closed).
# Example to allow the claude CLI family: claude(-[a-z]+)?
ALLOWED_RUN_PATTERNS=
