{
  "name": "telegram-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:types": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tests.json",
    "release": "scripts/release.sh",
    "release:package": "scripts/release-package.sh",
    "service:install": "scripts/service-install.sh",
    "service:uninstall": "scripts/service-uninstall.sh",
    "service:status": "scripts/service.sh status",
    "service:pause": "scripts/service.sh pause",
    "service:resume": "scripts/service.sh resume",
    "service:restart": "scripts/service.sh restart",
    "service:logs": "scripts/service.sh logs",
    "dev:local": "./dev.sh"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "grammy": "^1.44.0",
    "undici": "^8.4.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "8.0.16",
    "vitest": "^4.1.8"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.10": ">=8.5.10"
    }
  }
}
