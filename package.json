{
  "name": "telegram-bridge",
  "version": "0.1.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome check --write .",
    "lint:types": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tests.json",
    "release": "scripts/release.sh",
    "release:package": "scripts/release-package.sh",
    "service:install": "scripts/service-install.sh",
    "service:uninstall": "scripts/service-uninstall.sh",
    "service:status": "scripts/service.sh status",
    "service:pause": "scripts/service.sh pause",
    "service:resume": "scripts/service.sh resume",
    "service:restart": "scripts/service.sh restart",
    "service:logs": "scripts/service.sh logs",
    "dev:local": "./dev.sh",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "*.{ts,js,json}": "biome check --write --no-errors-on-unmatched"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "grammy": "^1.44.0",
    "undici": "^8.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@types/node": "^26.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vite": "8.1.3",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.10": ">=8.5.10"
    }
  }
}
